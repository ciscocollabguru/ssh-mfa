# ssh-mfa configuration. Copy to config/mfa.env and edit.
# Sourced by every script in scripts/. Shell syntax; no spaces around '='.

# ---------------------------------------------------------------------------
# Authentication policy
# ---------------------------------------------------------------------------
# pubkey+totp    SSH key AND TOTP code. Strongest; no password over SSH.
# password+totp  Unix password AND TOTP code, in one PAM conversation.
# A "key OR password, plus TOTP" mode is deliberately not offered: sshd's
# password method and its keyboard-interactive method share one PAM auth
# stack, so the two cannot prompt for different things. See docs/DESIGN.md.
AUTH_MODE="pubkey+totp"

# yes = users with no enrolled token can still log in with the first factor
#       only. Required during rollout so you do not lock anyone out.
# no  = a missing token is a failed login. Set by 50-enforce-strict.sh.
NULLOK="yes"

# ---------------------------------------------------------------------------
# Who is exempt from MFA
# ---------------------------------------------------------------------------
# Space-separated usernames that bypass MFA entirely.
EXEMPT_USERS="root"

# Members of this group also bypass MFA. Created if missing. Intended for
# service/automation accounts that authenticate with keys.
EXEMPT_GROUP="ssh-mfa-exempt"

# Accounts below this UID are treated as system accounts and are not
# required to enrol. Matches /etc/login.defs UID_MIN on AlmaLinux 8.
MIN_UID=1000

# Optional break-glass source. If set, connections from this CIDR skip the
# TOTP requirement. Leave empty unless you have an out-of-band-protected
# bastion. See docs/MANUAL-STEPS.md before using.
BREAKGLASS_CIDR=""

# ---------------------------------------------------------------------------
# Forced self-enrolment for new users
# ---------------------------------------------------------------------------
# yes = accounts with no token go into ENROLL_GROUP. They can log in with
#       their password alone, but sshd hands them a forced enrolment session
#       instead of a shell, and they are released from the group once they
#       have a working token. New local accounts are gated automatically by
#       ssh-mfa-reconcile.path. Install with scripts/45-enrollment-gate.sh.
# no  = an admin enrols people with scripts/40-enroll-user.sh.
#
# Note what this group means while someone is in it: password-only access to
# a forced enrolment prompt, and nothing else. It is not a shell.
ENROLL_GATE="no"
ENROLL_GROUP="ssh-mfa-enroll"

# ---------------------------------------------------------------------------
# Token parameters (passed to google-authenticator at enrolment)
# ---------------------------------------------------------------------------
# yes = enrol with -d (no code reuse) and -r/-R (rate limiting). The PAM
#       module then REWRITES the secret on every login to record that state,
#       which under SELinux needs the policy module from
#       scripts/16-selinux-policy.sh.
# no  = enrol without them. Nothing is ever written to the secret, so no
#       SELinux change is needed. The cost is real: a code can be replayed
#       within its validity window, and there is no per-user rate limit
#       (sshd's MaxAuthTries still caps attempts per connection).
TOTP_STATEFUL="yes"

TOTP_WINDOW=3          # accepted 30s steps either side of now (clock skew)
TOTP_RATE_LIMIT_N=3    # max attempts...
TOTP_RATE_LIMIT_S=30   # ...per this many seconds
SCRATCH_CODES=5        # one-time emergency codes generated per user
TOTP_ISSUER=""         # shown in the authenticator app; defaults to the FQDN

# Pass -i/-l to google-authenticator to set the issuer and label. Off by
# default: on some builds passing both percent-encodes the '?' and '&' of the
# otpauth URI, producing a QR code that many apps cannot parse. The default
# label is already user@hostname. Only turn this on if you have verified a
# generated QR code actually scans.
TOTP_LABEL_FLAGS="no"

# Seconds to allow one enrolment before giving up. Enrolment is driven
# non-interactively; a timeout means a build prompted for something
# unexpected rather than that the host is slow.
ENROLL_TIMEOUT=60

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
SSHD_DROPIN="/etc/ssh/sshd_config.d/50-mfa.conf"
BACKUP_ROOT="/var/backups/ssh-mfa"
ENROLL_OUT_DIR="/root/ssh-mfa-enrolments"
